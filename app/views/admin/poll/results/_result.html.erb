 <% by_question = @partial_results.group_by(&:question_id) %>
<% @poll.questions.each do |question| %>
  <h3><%= question.title %></h3>
  <table class="margin">
    <thead>
      <tr>
        <th><%= t("admin.results.result.table_answer") %></th>
        <th class="text-center"><%= t("admin.results.result.table_votes") %></th>
      </tr>
    </thead>
    <tbody>
      <% question.question_options.each_with_index do |option, i| %>
        <% by_option = by_question[question.id].present? ? by_question[question.id].group_by(&:option_id) : {} %>
        <tr id="question_<%= question.id %>_<%= i %>_result">
          <td><%= option.title %></td>
          <td class="text-center"><%= by_option[option.id].present? ? by_option[option.id].sum(&:amount) : 0 %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
